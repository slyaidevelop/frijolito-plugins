{
  "manifest_version": 3,
  "name": "Frijolito",
  "version": "1.0.0",
  "description": "Ask Frijolito anything and verify a Frijolito receipt from any page.",
  "homepage_url": "https://frijolito.app",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Frijolito",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "contextMenus", "storage"],
  "host_permissions": ["https://frijolito.app/*"],
  "minimum_chrome_version": "116"
}
