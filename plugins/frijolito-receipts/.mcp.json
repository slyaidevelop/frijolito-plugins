{
  "mcpServers": {
    "frijolito-receipts": {
      "command": "python3",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/frijolito_receipts_mcp.py"],
      "env": {
        "FRIJOLITO_BASE_URL": "${FRIJOLITO_BASE_URL:-https://frijolito.app}",
        "FRIJOLITO_API_KEY": "${FRIJOLITO_API_KEY:-}",
        "FRIJOLITO_ALLOW_LIVE": "${FRIJOLITO_ALLOW_LIVE:-0}"
      }
    }
  }
}
